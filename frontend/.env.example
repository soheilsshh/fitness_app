# OPTIONAL — only if you must point the Next.js app at a non-production API
# (e.g. local backend). Copy to .env.local:
#
#   cp .env.example .env.local
#
# Production needs NO .env file. Built-in default is:
#   https://api.fitinoo.ir

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8088

# OPTIONAL — canonical site domain used for <link rel="canonical">, Open Graph
# URLs, robots.txt and sitemap.xml. Production needs NO .env file — built-in
# default is:
#   https://fitinoo.ir

# NEXT_PUBLIC_SITE_URL=https://fitinoo.ir
