# Fitino frontend — standard Next.js static export (frontend/dist)
# Each route folder contains index.html (e.g. dist/admin/index.html).

server {
    listen 80;
    server_name fitinoo.ir www.fitinoo.ir;

    root /var/www/fitinoo/frontend/dist;
    index index.html;

    # robots.txt / sitemap.xml are real build outputs (app/robots.js,
    # app/sitemap.js) — must be served as-is, never rewritten to index.html.
    location = /robots.txt {
        try_files $uri =404;
    }

    location = /sitemap.xml {
        try_files $uri =404;
        add_header Content-Type "application/xml" always;
    }

    # Real HTTP 301s for legacy aliases (avoids relying on the client-side
    # JS redirect that next/navigation's redirect() emits under static export).
    location = /login { return 301 /auth/; }
    location = /login/ { return 301 /auth/; }
    location = /signup { return 301 /auth/; }
    location = /signup/ { return 301 /auth/; }
    location = /leadfunnel { return 301 /ali-rashidabadi/; }
    location = /leadfunnel/ { return 301 /ali-rashidabadi/; }

    location /_next/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Static files: never fall through to index.html (200 + HTML breaks <img>).
    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|mp4|webm|woff2?|ttf|css|js|map)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Serve Next's styled not-found page with a real 404 status instead of
    # nginx's bare default error page.
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}

# Deploy:
#   cd frontend && npm run build
#   rsync -av --delete dist/ root@fitinoo.ir:/var/www/fitinoo/frontend/dist/
#
# Reload:
#   sudo nginx -t && sudo systemctl reload nginx
